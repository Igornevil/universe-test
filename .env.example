# =============================================================================
# Universe Test - Environment variables example
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared infrastructure (used by docker-compose)
# -----------------------------------------------------------------------------
POSTGRES_PRODUCTS_USER=products
POSTGRES_PRODUCTS_PASSWORD=products_pass
POSTGRES_PRODUCTS_DB=products
POSTGRES_PRODUCTS_PORT=5432

POSTGRES_NOTIFICATIONS_USER=notifications
POSTGRES_NOTIFICATIONS_PASSWORD=notifications_pass
POSTGRES_NOTIFICATIONS_DB=notifications
POSTGRES_NOTIFICATIONS_PORT=5433

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# Products service
# -----------------------------------------------------------------------------
PRODUCTS_PORT=3001
PRODUCTS_DATABASE_URL=postgresql://products:products_pass@localhost:5432/products
PRODUCTS_RABBITMQ_URL=amqp://guest:guest@localhost:5672
PRODUCTS_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Notifications service
# -----------------------------------------------------------------------------
NOTIFICATIONS_DATABASE_URL=postgresql://notifications:notifications_pass@localhost:5433/notifications
NOTIFICATIONS_RABBITMQ_URL=amqp://guest:guest@localhost:5672
NOTIFICATIONS_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Web (Next.js)
# -----------------------------------------------------------------------------
WEB_PORT=3000
# Public URL used by the browser to reach Products API
NEXT_PUBLIC_PRODUCTS_API_URL=http://localhost:3001
